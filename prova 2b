Questão 8 – Tabuada com desafio
Faça um programa que solicite um número ao usuário e mostre sua tabuada de 1 até 10.

Porém, o programa deverá:

Não mostrar a multiplicação quando o resultado for igual a 20.

Parar completamente quando o resultado for igual a 40.

Obrigatório: Utilize for, if, continue e break.

resposta
c
#include <stdio.h>

int main() {
    int a, i;
    char continuar;

    printf("Tabuada classica\n");

    do {
        printf("\nEscolha a tabuada: ");
        scanf("%d", &a);

        printf("\nTabuada do %d:\n", a);

        for (i = 1; i <= 10; i++) {
            
        if (a*i==20){
        	i++;
		}printf("%d x %d = %d\n", a, i, a * i);
		if (a*i == 40){
			break;
		}
        }
        printf("\nDeseja calcular outra tabuada? (s/n): ");
        scanf(" %c", &continuar);

    } while (continuar == 's' || continuar == 'S');

    printf("\nPrograma encerrado!\n");

    return 0;
}


